# Generate a secure random key: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Separate key for AES-256-GCM encryption of TOTP and AI provider secrets.
# Generate it independently from JWT_SECRET using the command above.
ENCRYPTION_SECRET=

# Runtime mode. In production JWT_SECRET is mandatory for signed OAuth state.
NODE_ENV=development

# TEMPORARY: set to true to allow arbitrary non-empty values in email fields.
# Must be removed/disabled before production.
ALLOW_ANY_EMAIL_TEMP=false

# Server port (default: 3001)
PORT=3001

# Server public URL (for OAuth callbacks, default: http://localhost:3001)
SERVER_URL=http://localhost:3001

# Client URL (for OAuth redirects and cookie-authenticated API requests, default: http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Comma-separated allowlist if more than one client origin is used. Cookie-authenticated
# unsafe requests must send an exact matching Origin header.
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173

# WebAuthn/FIDO2. In production this must be the exact domain hosting the app.
# WEBAUTHN_RP_ID=example.com
# WEBAUTHN_RP_NAME=OpenFlash

# PostgreSQL connection string. Use a distinct database role with only the
# permissions required by this application; never expose this value to the client.
DATABASE_URL=postgresql://openflash:change-me@localhost:5432/openflash

# Reverse-proxy configuration.
# TRUST_PROXY=loopback

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Apple Sign-In — https://developer.apple.com/account/resources/services
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
